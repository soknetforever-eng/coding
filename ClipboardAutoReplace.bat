@echo off
setlocal
:: ============================================================
::  Clipboard Auto-Replace  (single file, Windows)
:: ============================================================
::  HOW TO USE
::   1. Edit the rules below, one per line, as FIND=REPLACE
::   2. Save this file, then double-click it. It opens a console
::      window titled "Clipboard Auto-Replace", minimized to the
::      taskbar, and watches your clipboard from there.
::   3. Copy (Ctrl+C) anything containing FIND text, then Paste
::      (Ctrl+V) and you'll get the REPLACE version instead.
::   4. To pick up rule changes: stop it (step 5), edit the
::      rules, save, then double-click this file again.
::   5. To stop it: click its "Clipboard Auto-Replace" entry in
::      the taskbar to restore the window, then close it (or
::      press Ctrl+C in it).
::   6. To run this automatically at login: press Win+R, type
::      shell:startup, press Enter, then put a shortcut to this
::      file in the folder that opens.
::   7. Status/troubleshooting: it writes ClipboardAutoReplace.log
::      next to this file, recording when it started, how many
::      rules it loaded, every replacement, and any errors.
::
:: RULES START
:: 8888=TTTTT
:: 9999=TTTTT
:: 7777=TTTTT
:: 6666=TTTTT
:: 1111=TTTTT
:: 2222=TTTTT
:: 3333=TTTTT
:: 4444=TTTTT
:: 5555=TTTTT
:: RULES END
:: ============================================================

set "CAR_FILE=%~f0"
start "Clipboard Auto-Replace" /min powershell -NoProfile -ExecutionPolicy Bypass -Sta -EncodedCommand 
